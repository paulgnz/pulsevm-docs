{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "docs/.vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ],
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/",
      "/((?!assets/|.*\\.[A-Za-z0-9]+$).*)"
    ]
  }
}
